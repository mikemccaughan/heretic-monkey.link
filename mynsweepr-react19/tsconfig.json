{
    "compilerOptions": {
        "jsx": "react",
        "allowJs": true,
        "checkJs": true,
        "lib": [
            "DOM",
            "ESNext"
        ],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler"
    },
    "files": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "references": [
        {
            "path": "./tsconfig.app.json"
        },
        {
            "path": "./tsconfig.node.json"
        }
    ]
}