{
  "name": "heretic-monkey.link",
  "version": "0.1.0",
  "description": "",
  "homepage": "https://github.com/mikemccaughan/heretic-monkey.link#readme",
  "bugs": {
    "url": "https://github.com/mikemccaughan/heretic-monkey.link/issues"
  },
  "license": "ISC",
  "author": "Mike McCaughan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikemccaughan/heretic-monkey.link.git"
  },
  "workspaces": [
    "/workspaces/heretic-monkey.link/hm-datetimepicker",
    "/workspaces/heretic-monkey.link/hm-grid",
    "/workspaces/heretic-monkey.link/mynsweepr-angular",
    "/workspaces/heretic-monkey.link/mynsweepr-react19",
    "/workspaces/heretic-monkey.link/mynsweepr-vue"
  ],
  "type": "module",
  "main": "server.cjs",
  "scripts": {
    "start": "yarn node server.cjs",
    "start:deployed": "yarn node ./publish/server.cjs",
    "build:yarn": "yarn set version stable && yarn set version latest",
    "build:prebuild": "yarn dlx npm-check-updates -u && yarn config set enableImmutableInstalls false && yarn install",
    "build:directories": "rm -rf publish && mkdir -p publish && mkdir -p publish/mynsweepr-angular && mkdir -p publish/mynsweepr-react19 && mkdir -p publish/hm-datetimepicker",
    "build:nobuild": "yarn install && cp *.*js ./publish/ && cp *.html ./publish/ && cp *.css ./publish/ && cp -r hm-grid ./publish/hm-grid && cp -r design ./publish/design && cp -r ../hm-datetimepicker/dist/ ./publish/hm-datetimepicker/",
    "build:workspaces": "yarn workspaces focus --all && yarn workspaces foreach -v --all --exclude heretic-monkey.link run build",
    "build:predeploy": "bash ./build-mynsweeprs.sh",
    "build:deploy": "yarn run build",
    "build": "yarn run build:yarn && yarn run build:prebuild && yarn run build:directories && yarn run build:workspaces && yarn run build:nobuild && yarn run build:predeploy && yarn config set enableImmutableInstalls true",
    "test": "yarn node --test"
  },
  "dependencies": {
    "@isaacs/brace-expansion": "^5.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@yarnpkg/pnpify": "^4.1.7",
    "@yarnpkg/sdks": "^3.3.1",
    "body-parser": "^2.4.0",
    "brace-expansion": "^5.0.12",
    "braces": "^3.0.3",
    "cacache": "^21.0.1",
    "cookie": "^2.0.2",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ejs": "^7.0.2",
    "esbuild": "^0.28.2",
    "express": "5",
    "glob": "^14.0.4",
    "http-proxy-middleware": "^4.2.1",
    "js-yaml": "^5.5.0",
    "jsonpath-plus": "^11.3.0",
    "loader-utils": "^3.3.1",
    "micromatch": "^4.0.8",
    "minimatch": "^11.0.5",
    "nanoid": "^6.0.2",
    "path-to-regexp": "^9.0.0",
    "picomatch": "^4.0.7",
    "qs": "^6.17.1",
    "rollup": "^4.68.2",
    "send": "^1.2.1",
    "serialize-javascript": "7.1.4",
    "serve-static": "^2.2.1",
    "tar": "^7.5.22",
    "typescript": "^5.9.3",
    "undici": "^8.12.4",
    "vite": "^8.3.7",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/braces": "^3",
    "@types/ejs": "^3",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4",
    "@types/lodash": "^4",
    "@types/micromatch": "^4",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4",
    "@types/qs": "^6",
    "@types/serve-static": "^2.2.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/typescript-estree": "^8.72.2",
    "eslint": "^10.14.0",
    "lodash": "^4.18.1",
    "npm-check-updates": "^23.1.1",
    "typescript-eslint": "^8.72.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "yarn@4.18.1"
}
