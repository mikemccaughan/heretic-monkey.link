{
  "name": "heretic-monkey.link",
  "version": "0.1.0",
  "description": "",
  "main": "server.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "hm-walls",
    "hm-walls-api",
    "material-test"
  ],
  "scripts": {
    "start": "yarn node server.cjs",
    "build:yarn": "yarn set version latest",
    "build:prebuild": "yarn dlx npm-check-updates -u && yarn config set enableImmutableInstalls false && yarn install",
    "build:directories": "rm -rf publish && mkdir -p publish && mkdir -p publish/mynsweepr-angular && mkdir -p publish/mynsweepr-hooks && mkdir -p publish/mynsweepr-react && mkdir -p publish/mynsweepr-react19 && mkdir -p publish/hm-datetimepicker",
    "build:nobuild": "yarn install && cp *.*js publish/ && cp *.html publish/ && cp *.css publish/ && cp -r hm-grid publish/hm-grid && cp -r design publish/design && cp -r ../hm-datetimepicker/dist/* publish/hm-datetimepicker",
    "build:workspaces": "yarn workspaces focus --all && yarn workspaces foreach -v --all --exclude heretic-monkey.link run build",
    "build:predeploy": "bash ./build-mynsweeprs.sh",
    "build": "yarn run build:yarn && yarn run build:prebuild && yarn run build:directories && yarn run build:nobuild && yarn run build:workspaces && yarn run build:predeploy && yarn config set enableImmutableInstalls true",
    "test": "yarn node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikemccaughan/heretic-monkey.link.git"
  },
  "author": "Mike McCaughan",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mikemccaughan/heretic-monkey.link/issues"
  },
  "homepage": "https://github.com/mikemccaughan/heretic-monkey.link#readme",
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@isaacs/brace-expansion": "^5.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@yarnpkg/pnpify": "^4.1.6",
    "@yarnpkg/sdks": "^3.3.0",
    "body-parser": "^2.3.0",
    "brace-expansion": "^5.0.8",
    "braces": "^3.0.3",
    "cacache": "^21.0.1",
    "cookie": "^2.0.1",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.1",
    "express": "5",
    "glob": "^13.0.6",
    "http-proxy-middleware": "^4.1.1",
    "js-yaml": "^5.2.1",
    "jsonpath-plus": "^10.4.0",
    "loader-utils": "^3.3.1",
    "micromatch": "^4.0.8",
    "minimatch": "^10.2.5",
    "nanoid": "^5.1.16",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.4",
    "qs": "^6.15.3",
    "rollup": "^4.62.2",
    "send": "^1.2.1",
    "serialize-javascript": "7.0.7",
    "serve-static": "^2.2.1",
    "tar": "^7.5.19",
    "typescript": "^5.9.3",
    "undici": "^8.5.0",
    "vite": "^8.1.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/braces": "^3",
    "@types/ejs": "^3",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4",
    "@types/lodash": "^4",
    "@types/micromatch": "^4",
    "@types/node": "^26.1.0",
    "@types/picomatch": "^4",
    "@types/qs": "^6",
    "@types/serve-static": "^2.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/typescript-estree": "^8.62.1",
    "eslint": "^10.6.0",
    "lodash": "^4.18.1",
    "npm-check-updates": "^22.2.9",
    "typescript-eslint": "^8.62.1"
  }
}
